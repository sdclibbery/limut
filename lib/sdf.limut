include 'lib/visual.limut'

// 2d signed distance fields for visualsynth px chains, from the GLSL at
// https://iquilezles.org/articles/distfunctions2d/
// A shape gives a distance (negative inside); drawing it is a separate step.
//
//   v1 visualsynth, px=sdcircle{r:1/2}>>sdfill
//   v1 visualsynth, px=sdstar{r:3/4}>>sdbands
//   v1 visualsynth, px=min{sdcircle{r:1/3}, sdbox{b:{x:3/4,y:1/8}}}>>sdfill
//
// Coordinates: y up, -1..1 vertically, so radii are fractions of half the frame height.
//
// The point is the first argument, so a positional argument is only the radius when the call is
// piped: px=sdcircle{1/2} works, but in px=sdfill{sdcircle{1/2}} the 1/2 is the point. Name the
// arguments, or pass the point (sdcircle{id, 1/2}), anywhere else.
//
// A value used more than once is named either by passing it to a helper (free when it is already a
// built value) or with let{} (better when an expression is reused, as in sdblend and sdcross, but
// only if everything the bound expression mentions is named too, or it gets rebuilt).
// let{} gotchas inside a function body:
//   - start the body with `id >>`, or the chain is taken for an audio one (renders flat white)
//   - the call that ends the chain must use named args, since >> shifts the chain value into a
//     call with positional ones
//   - don't pipe an argument (`a >> let{..}`): it changes what id means for the callsite's args

//// Machinery

// Distances are splatted across all four channels, like length{}.
set sdval = {v} -> v.x

// z and w must be zero: length{} and dot{} work on xyz and the incoming w is 1.
set sdflat = {in} -> in >> set{z:0, w:0}

// Build a 2d point out of two splatted values.
set sdvec = {a, b} -> {x:1,w:0}*a + {y:1,w:0}*b

set sdbcast = {a} -> {x:1,y:1,w:0}*a

// 0 below zero, 1 above: selects without a condition, eg as the t of a mix{}.
set sdstep = {v} -> max{sgn{v}, 0}

// Distance from the folded corner, signed by side of the mirror line.
set sdlensx = {p} -> sdval{length{p} * sgn{p.x}}
set sdlensy = {p} -> sdval{length{p} * sgn{p.y}}

// Mirror fold about the line through the origin with normal n.
set sdfold = {p, n} -> p - n*2*min{dot{p,n}, 0}

set sdabsx = {p} -> sdvec{abs{p.x}, p.y}

// Shared ending of the regular polygons: distance to the flat edge of half width hx at height ry.
set sdtrim = {p, hx, ry} -> sdlensy{sdvec{p.x - clamp{p.x, -hx, hx}, p.y - ry}}

//// Shapes
// The point is the first argument, so they pipe or take a point: px=sdcircle{id*2, 1/4}.

set sdcircle = {in:id, r:1/2} -> sdval{length{sdflat{in}} - r}

// b is the half extent.
set sdbox1 = {d} -> sdval{length{max{d,0}} + min{max{d.x, d.y}, 0}}
set sdbox = {in:id, b:1/2} -> sdbox1{abs{sdflat{in}} - b}

set sdsegment1 = {pa, ba} -> sdval{length{pa - ba*clamp{dot{pa,ba}/dot{ba,ba}}}}
set sdsegment = {in:id, ax:-1/2, ay:0, bx:1/2, by:0} ->
  sdsegment1{sdflat{in} - {x:ax, y:ay, w:0}, {x:bx-ax, y:by-ay, w:0}}

// Equilateral triangle of radius r, pointing up. 1.7320508 is sqrt(3), 0.866025404 half of it.
set sdtriangle0 = {p, r} -> sdvec{abs{p.x} - r, p.y + r/1.7320508}
set sdtriangle2 = {p, r} -> sdval{-length{sdvec{p.x - clamp{p.x, -2*r, 0}, p.y}} * sgn{p.y}}
set sdtriangle1 = {q, r} -> sdtriangle2{
  q.x + 1.7320508*q.y > 0 ?? mat2{q, 1/2, -0.866025404, -0.866025404, -1/2} ?: q,
  r
}
set sdtriangle = {in:id, r:1/2} -> sdtriangle1{sdtriangle0{sdflat{in}, r}, r}

// r is the inradius.
set sdhexagon = {in:id, r:1/2} ->
  sdtrim{sdfold{abs{sdflat{in}}, {x:-0.866025404, y:1/2, w:0}}, 0.577350269*r, r}

// r is the inradius. y is flipped on the way in so it points up.
set sdpentagon = {in:id, r:1/2} -> sdtrim{sdfold{
  sdfold{sdabsx{sdflat{in}*{x:1, y:-1, w:0}}, {x:-0.809016994, y:0.587785252, w:0}},
  {x:0.809016994, y:0.587785252, w:0}
}, 0.726542528*r, r}

// Star with n points of radius r. m is the cut depth: 2 is a regular n-gon, n makes needles; it
// need not be whole (the classic star is n:5, m a shade over 3).
set sdstarbn = {l, bn} -> sdvec{l*cos{bn}, l*abs{sin{bn}}}
set sdstar0 = {p, an} -> sdstarbn{length{p}, (atan{p.x, p.y} % (2*an)) - an}
set sdstar2 = {p, ecs, hi} -> sdlensx{p + ecs*clamp{-dot{p, ecs}, 0, hi}}
set sdstar1 = {p, r, an, en} -> sdstar2{
  sdstar0{p, an} - {x:r*cos{an}, y:r*sin{an}, w:0},
  {x:cos{en}, y:sin{en}, w:0},
  r*sin{an}/sin{en}
}
set sdstar = {in:id, r:1/2, n:5, m:10/3} -> sdstar1{sdflat{in}, r, 3.1415927/n, 3.1415927/m}

// Heart of half height r. The original works in its own unit space, hence the scale and shift.
set sdheart2 = {q} -> sqrt{dot{q - {x:1/4, y:3/4, w:0}}} - 0.35355339
set sdheart3 = {q} -> sqrt{min{
  dot{q - {y:1, w:0}},
  dot{q - sdbcast{max{(q.x+q.y)/2, 0}}}
}} * sgn{q.x - q.y}
set sdheart1 = {p, s} -> sdval{(p.y + p.x > 1 ?? sdheart2{p} ?: sdheart3{p}) * s}
set sdheart = {in:id, r:1/2} -> sdheart1{sdabsx{sdflat{in}}*(3/5)/r + {y:3/5, w:0}, r*5/3}

// Greek cross: arms of half length arm and half thickness thick, rounded by r.
// sdval's argument is named because the body is a chain (see the let{} gotchas above).
set sdcross0 = {p} -> p.y > p.x ?? p.yx ?: p
set sdcross1 = {p, arm, thick, r} ->
  id >> let{sdcp, p} >> let{sdcq, sdcp - {x:arm, y:thick, w:0}} >> let{sdck, max{sdcq.y, sdcq.x}}
     >> sdval{v: sgn{sdck} * length{max{sdck > 0 ?? sdcq ?: sdvec{thick - sdcp.x, -sdck}, 0}} + r}
set sdcross = {in:id, arm:1/2, thick:1/6, r:0} -> sdcross1{sdcross0{abs{sdflat{in}}}, arm, thick, r}

// Wave of arcs of radius ra along x. tb is how much of each circle is used: near 0 shallow
// scallops, 1/2 half circles, 1 whole circles.
set sdcwd = {q, cox, coy, ra} ->
  coy*q.x > cox*q.y ?? length{q - {x:cox, y:coy, w:0}} ?: abs{length{q} - ra}
// sdcwd is evaluated at two points, so it is a pxfn{} to avoid two copies in the shader.
set sdcw1 = {p, cox, coy, ra} -> sdcw1h{p, cox, coy, pxfn{{q} -> sdcwd{q, cox, coy, ra}}}
set sdcw1h = {p, cox, coy, d} -> sdval{min{
  p >> d,
  sdvec{abs{p.x - cox*2}, coy*2 - p.y} >> d
}}
set sdcw0 = {p, cox, coy, ra} -> sdcw1{sdvec{abs{(p.x % (cox*4)) - cox*2}, p.y}, cox, coy, ra}
// Lift by coy to centre the wave on the origin.
set sdcw = {p, ra, a} -> sdcw0{p + {y:ra*cos{a}, w:0}, ra*sin{a}, ra*cos{a}, ra}
set sdcirclewave = {in:id, tb:1/2, ra:1/4} -> sdcw{sdflat{in}, ra, 2.6179939*max{tb, 0.0001}}

//// Combining
// Union and intersection are min{} and max{}.

// Round corners by r (also grows the shape by r).
set sdround = {d, r:1/16} -> d - r

// Outline of half thickness w.
set sdannular = {d, w:1/32} -> abs{d} - w

// Cut b out of a.
set sdsub = {a, b} -> max{a, -b}

// Smooth union of width k. Approximate distance near the join.
set sdblend = {a, b, k:1/8} ->
  id >> let{sdba, a} >> let{sdbb, b} >> let{sdbh, clamp{1/2 + (sdbb-sdba)/(k*2)}}
     >> mix{sdbb, sdba, sdbh} - sdbh*(1 - sdbh)*k

//// Drawing
// Take the distance first, so either sdfill{sdcircle{}} or sdcircle{}>>sdfill. soft is the
// antialiasing width.

set sdfill = {d, col:#fff, bg:#000, soft:0.01} -> mix{col, bg, smoothstep{d, -soft, soft}}

// Edge only, w either side.
set sdstroke = {d, w:0.01, col:#fff, bg:#000, soft:0.01} ->
  mix{col, bg, smoothstep{abs{d} - w, -soft, soft}}

// Inigo Quilez's field visualisation: inside/outside colours, distance fade and bands, white zero
// line. Useful while building a shape. k is the fade rate, n the band count.
set sdbands = {d, outside:#e93, inside:#adf, k:6, n:150, soft:0.01} -> mix{
  mix{outside, inside, sdstep{-d}} * (1 - exp{-k*abs{d}}) * (0.8 + 0.2*cos{n*d}),
  #fff,
  1 - smoothstep{abs{d}, 0, soft}
}
