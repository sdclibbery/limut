include 'lib/nodes.limut'

set flanger = {control:[0,1]l8@f,feedback:0,lo:0.0005,hi:0.007} ->
  feedback>0
  ?? {delay{0.01,max:0.01},delay{0.01+lo+control^2*(hi-lo),feedback:gain{feedback*0.8},max:0.1}}/2
  ?: {dry,delay{lo+control^2*(hi-lo),max:0.1}}/2

// Times are raw seconds: the delay time is a connected signal, so units are not converted.
set chorus = {rate:0.62, time:0.0025, depth:0.002, voices:3, spread:3/4, wobble:0.0003, wrate:6.67} ->
  parallel{ {i} ->
    delay{
      time + lfo{rate, lo:-depth, hi:depth, phase:i/voices} + (wobble>0 ?? osc{'sine', freq:wrate}*wobble ?: 0),
      max:50ms
    } >> panner{voices>1 ?? spread*(2*i/(voices-1)-1) ?: 0},
  voices } * (2/voices)^(1/2)

set ensemble = {rate:0.5, time:0.0035, depth:0.0018} ->
  {dry, chorus{rate:rate, time:time, depth:depth, voices:2, spread:1, wobble:0}} * (1/2)^(1/2)

set phaser = {control:[0,1]l4@f,lo:300,hi:2600,stages:4,q:1/2} -> {
  dry,
  series{
   	apf{freq:lo+control^2*(hi-lo),q:q},
    stages
  }
}/2

// Sawtooth delay ramp a to b seconds over each length, with an instant reset: an exact playback
// rate of 1-(b-a)/length. phase (0..1) staggers overlapping grains' resets.
set grainramp = {a, b, length, phase} -> [
  (a+(b-a)*phase)*1s :\((1-phase)*length*1s),
  b*1s :\0,
  a*1s :\(phase*length*1s)
]t@s

// Smoothstep window, zero at the delay reset. Windows at phase p and p+1/2 sum to exactly 1.
set grainwindow = {length, phase} ->
  phase<=1/2
  ?? [4*phase^2*(3-4*phase):~((1/2-phase)*length*1s), 1:~(length/2*1s), 0:~(phase*length*1s)]t@s
  ?: [4*(1-phase)^2*(4*phase-1):~((1-phase)*length*1s), 0:~(length/2*1s), 1:~((phase-1/2)*length*1s)]t@s

set grain = {ratio, length:0.03, phase:0, max} ->
delay{ // Sawtooth delay ramp resamples the audio to shift its pitch by exactly ratio
  grainramp{
    a: ratio>=1 ?? (ratio-1)*length ?: 0,
    b: ratio>=1 ?? 0 ?: (1-ratio)*length,
    length:length, phase:phase
  },
  max: max??max?:length*16*1s
}
>> gain{ grainwindow{length:length, phase:phase} } // Window out the delay reset

set shifter = {ratio, length:0.1} -> { // Two overlapping grains; windows sum to one
	grain{ratio, length:length, phase:0},
  grain{ratio, length:length, phase:1/2}
}

set ultracomb = {f:smooth{[]r1@f,att:1}, p:smooth{[]r2/3@f,att:1}, s:smooth{[]r1/2@f,att:1}, stages:6} -> series{{
  dry,
  delay{0.0002 + f^2*0.007,max:0.1} - delay{0.004 + f^2*0.01,max:0.1}, // Flanger part
  series{apf{300 + p^2*2000},6}, // Phaser part
  shifter{0.95 + s*0.1} // Shifter part
}/3.3,stages}

set disperser = {freq:440,q:3,stages:24} -> series{apf{freq,q}, stages}

set reverb = {length:1b,curve:3} -> convolver{
  env: {
    l:{x,c:curve} -> (1-x)^c,
    r:{x,c:curve} -> (1-x)^c
  },
  length:length
}

// Nonlinear "gated" reverb: a flat dense tail that chops off abruptly. rise>0 swells the tail
// before the cut. fade is the chop length as a fraction of length.
set gatedverb = {length:1/4b, fade:0.05, rise:0, hpf:200} -> bwhpf{hpf} >> convolver{
  env: {
    l:{x,f:fade,r:rise} -> (x<1-f ?? 1+r*x ?: (1-x)/f*(1+r)),
    r:{x,f:fade,r:rise} -> (x<1-f ?? 1+r*x ?: (1-x)/f*(1+r)),
    step:64
  },
  length:length
}

set echo = {time:1/8b,feedback:0.7,max} -> delay{time,feedback:feedback,max:max??max?:time*2}

set pingpong = {time:1/4b,feedback:0.7} -> panner{1}>>delay{time,feedback:flipper*feedback}

set demon = {} -> {shifter{3/4},shifter{1/2}}>>{idnode,ultracomb*0.7}*0.7

set airverb = {delay:1/2b} ->  flanger>>{dry,pingpong{delay}}>>reverb{3b}

set shimmer = {ratio:2,length:2s} -> shifter{ratio}>>reverb{length}*+3db

set tape = {wow:1, cut:-10db} -> delay{wow*([0,20ms]n2+[0,2ms]n0.2),max:500ms}>>hsf{cut,freq:7000hz}>>lsf{cut,freq:200hz}

set duck = {depth:1, length:0.5, period:1, attack:0.1} -> [
  (1-depth):^3:length,
  1:_(period-length-attack),
  1:\attack
]t@s

// Envelope follower: a ~0..1 control signal tracking the input level, for driving a gain.
// freq is the response speed. Attack and release are symmetric; asymmetric would need a worklet.
// The default boost of pi/2 restores a sine's peak (the rectified average is 2A/pi).
set follower = {freq:20, boost:pi/2} -> shaper{ {x} -> abs{x} } >> bwlpf4{freq} >> gain{boost}

// Split into count log-spaced bands from 20Hz to 20kHz, run each through chain{i, centre}, and
// sum. Bands are differences of lowpasses (top band is input minus lowpass), so adjacent bands
// share a filter and cancel exactly: uniform processing is fully transparent at any filter slope.
set multiband = {chain:1, count:3} -> parallel{
  {i} -> (
    i==count-1
    ?? (i==0 ?? dry ?: dry - bwlpf{20*1000^(i/count)})
    ?: (i==0 ?? bwlpf{20*1000^((i+1)/count)} ?: bwlpf{20*1000^((i+1)/count)} - bwlpf{20*1000^(i/count)})
  ) >> chain{i, 20*1000^((i+1/2)/count)},
  count
}
set multiband2 = multiband

// 4 pole crossovers: less bleed between bands, still transparent.
set multiband4 = {chain:1, count:3} -> parallel{
  {i} -> (
    i==count-1
    ?? (i==0 ?? dry ?: dry - bwlpf4{20*1000^(i/count)})
    ?: (i==0 ?? bwlpf4{20*1000^((i+1)/count)} ?: bwlpf4{20*1000^((i+1)/count)} - bwlpf4{20*1000^(i/count)})
  ) >> chain{i, 20*1000^((i+1/2)/count)},
  count
}

// Bandpass variant: tighter bands than multiband, but they do not sum back to the input exactly
// (ripple and phase cancellation at the crossovers). lo..hi is the overall range. The chain is
// given {i, centre, lo, hi}, the band's own edges, so it can filter something else identically.
set multibandbp = {chain:1, count:3, lo:20, hi:20000} -> parallel{
  {i} -> bwlpf{lo*(hi/lo)^((i+1)/count)} >> bwhpf{lo*(hi/lo)^(i/count)}
         >> chain{i, lo*(hi/lo)^((i+1/2)/count), lo*(hi/lo)^(i/count), lo*(hi/lo)^((i+1)/count)},
  count
}

// Vocoder: impose a modulator's spectral envelope on the carrier (this fx chain's signal).
// Pass the modulator as a .pre tap, eg vocoder{voice.pre}, and route it to the silent bus. The
// carrier needs to be rich and bright (detuned saws, pulse, noise) so every band has energy.
// freq is the follower speed (higher = crisper consonants). tilt lifts higher bands by tilt*6dB
// per octave above 100Hz to counter a dark modulator, which otherwise sounds muffled.
// lo/hi default to the speech band; use lo:20, hi:20000 for full range.
set vocoder = {mod, count:16, freq:40, tilt:0.8, boost:pi/2, lo:150, hi:7000} -> multibandbp{
  {i, centre, lo, hi} -> gain{
    mod >> bwlpf{hi} >> bwhpf{lo}
        >> follower{freq, boost:boost*(centre/100)^tilt}
  },
  count, lo, hi
}

// Apply a vocoder using this player as the modulator and an oscillator as the carrier
set vocodethis = {wave:'saw', unison:3, freq:eventpitch@f, tilt:0.3} ->
  parallel{ {i} -> osc{wave, freq:freq*(1+(i-floor{unison/2})*0.01)}, unison }
    >>vocoder{this.player.pre*2, tilt:tilt, count:17}

// Speaker cabinet voicing, to tame the fizz of heavy saturation: cut the sub, dip 2.6kHz, lift
// 900Hz, roll off the top.
set cabinet = {flatten:1} ->
  hpf4{60 + flatten*60} >>
  pkf{(-5db)^flatten, freq:2600, q:1} >>
  pkf{(3db)^flatten, freq:900, q:1/2} >>
  bwlpf4{12000 - flatten*4000}

// OTT style multiband compression: hard, fast compression per band.
set ott = {depth:1, count:3, trim:1} -> multiband4{
  {i,centre} -> compressor{threshold:-30db, ratio:(12db)^depth, attack:2ms, release:60ms, knee:6db},
  count
} * trim /3
