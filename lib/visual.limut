// This library includes smooth noise, 2d transforms and a kaleidoscope pattern for visualsynth px
// chains, built entirely out of the shader nodes: pxhash for the randomness, floor/fract for the
// lattice, smoothstep for the fade curve, mix for the interpolation and parallel/loop for the
// repetition. Nothing here is implemented in javascript.
//
// pxhash gives an independent random value per pixel, ie white noise. Smooth noise instead hashes
// the corners of a lattice cell and interpolates between them, so neighbouring pixels get
// neighbouring values. Value noise interpolates the corner values themselves; perlin (gradient)
// noise interpolates a random gradient at each corner, which looks less blocky and is signed.
//
// All of them take the incoming px value as their first argument, so they pipe:
//   v1 visualsynth, px=noise2{scale:16}
//   v1 visualsynth, px=fbm2>>tex1d{{x}->{labh:x}}
//   v1 visualsynth, px=noise2>>cospal{#05a}

//// Shared machinery
// Only the channels a noise is over may vary: the rest are forced flat so a lattice point hashes
// the same all the way along them. w is forced to zero everywhere, since pxhash hashes all four
// components and the incoming w is 1, which scaling would otherwise turn into a stray dimension.
set noiseflat1 = {in, scale} -> in*scale >> set{y:0, z:0, w:0}
set noiseflat2 = {in, scale} -> in*scale >> set{z:0, w:0}
set noiseflat3 = {in, scale} -> in*scale >> set{w:0}

// One square of value noise: bilinear between the four corner hashes of lattice cell i, using the
// already faded fractional position f. The offsets carry w:0 because an absent alpha reads as 1.
set noiseface = {i, f, seed} -> mix{
  mix{ pxhash{i, seed}.x,               pxhash{i+{x:1,w:0}, seed}.x,     f.x },
  mix{ pxhash{i+{y:1,w:0}, seed}.x,     pxhash{i+{x:1,y:1,w:0}, seed}.x, f.x },
  f.y
}

// One corner's gradient contribution: a random vector in -1 to 1 dotted with the offset from that
// corner. dot works on xyz, and the unused dimensions are flat, so one definition covers 1d/2d/3d.
set perlingrad = {i, d, o, seed} -> dot{ pxhash{i+o, seed}*2-1, d-o }

set perlinface = {i, d, f, seed} -> mix{
  mix{ perlingrad{i, d, {w:0}, seed},       perlingrad{i, d, {x:1,w:0}, seed},     f.x },
  mix{ perlingrad{i, d, {y:1,w:0}, seed},   perlingrad{i, d, {x:1,y:1,w:0}, seed}, f.x },
  f.y
}

//// Value noise, 0 to 1
// scale is how many lattice cells the coordinate space is divided into. noise3 takes its third
// dimension from the incoming z, which is zero unless you put something there: drive it off a
// timevar for noise that moves rather than one that scrolls, eg px=noise3{id>>set{z:[]l8}}
set noise1lerp = {i, f, seed} -> mix{ pxhash{i, seed}.x, pxhash{i+{x:1,w:0}, seed}.x, f.x }
set noise1at = {p, seed} -> noise1lerp{floor{p}, smoothstep{fract{p}}, seed}
set noise1 = {in:id, scale:4, seed:0} -> noise1at{noiseflat1{in, scale}, seed}

set noise2at = {p, seed} -> noiseface{floor{p}, smoothstep{fract{p}}, seed}
set noise2 = {in:id, scale:4, seed:0} -> noise2at{noiseflat2{in, scale}, seed}

set noise3lerp = {i, f, seed} -> mix{ noiseface{i, f, seed}, noiseface{i+{z:1,w:0}, f, seed}, f.z }
set noise3at = {p, seed} -> noise3lerp{floor{p}, smoothstep{fract{p}}, seed}
set noise3 = {in:id, scale:4, seed:0} -> noise3at{noiseflat3{in, scale}, seed}

//// Perlin (gradient) noise
// The s versions are signed, roughly -1 to 1, which is what displacing a coordinate wants. The
// plain ones are shifted and clamped into 0 to 1 so they compose like everything else.
set perlin1d = {i, d, seed} -> mix{ perlingrad{i, d, {w:0}, seed}, perlingrad{i, d, {x:1,w:0}, seed}, smoothstep{d}.x }
set perlin1at = {p, seed} -> perlin1d{floor{p}, fract{p}, seed}
set perlin1s = {in:id, scale:4, seed:0} -> perlin1at{noiseflat1{in, scale}, seed}
set perlin1 = {in:id, scale:4, seed:0} -> clamp{ perlin1s{in, scale, seed}*3/4 + 1/2 }

set perlin2d = {i, d, seed} -> perlinface{i, d, smoothstep{d}, seed}
set perlin2at = {p, seed} -> perlin2d{floor{p}, fract{p}, seed}
set perlin2s = {in:id, scale:4, seed:0} -> perlin2at{noiseflat2{in, scale}, seed}
set perlin2 = {in:id, scale:4, seed:0} -> clamp{ perlin2s{in, scale, seed}*3/4 + 1/2 }

set perlin3lerp = {i, d, f, seed} -> mix{
  perlinface{i, d, f, seed},
  perlinface{i+{z:1,w:0}, d-{z:1,w:0}, f, seed},
  f.z
}
set perlin3d = {i, d, seed} -> perlin3lerp{i, d, smoothstep{d}, seed}
set perlin3at = {p, seed} -> perlin3d{floor{p}, fract{p}, seed}
set perlin3s = {in:id, scale:4, seed:0} -> perlin3at{noiseflat3{in, scale}, seed}
set perlin3 = {in:id, scale:4, seed:0} -> clamp{ perlin3s{in, scale, seed}*3/4 + 1/2 }

//// Octave noise
// Four octaves of value noise, each at twice the frequency and half the amplitude, normalised back
// to 0 to 1. parallel{} builds one copy of its chain per octave and sums them, which is what an
// octave sum is; the octave index is an ordinary number here, since parallel unrolls, so 2^i is a
// per copy constant. Change the 4 for more or fewer octaves (and the divisor, which is 2^octaves-1,
// their weights summed).
set fbm2 = {in:id, scale:4, seed:0} ->
  parallel{{i} -> noise2{in, scale*(2^i), seed}*(8/(2^i)), 4}/15

set fbm3 = {in:id, scale:4, seed:0} ->
  parallel{{i} -> noise3{in, scale*(2^i), seed}*(8/(2^i)), 4}/15

// Turbulence: the same sum over the absolute value of each signed octave, giving the creased,
// billowy look that suits smoke and marble
set turb2 = {in:id, scale:4, seed:0} ->
  parallel{{i} -> abs{noise2{in, scale*(2^i), seed}*2-1}*(8/(2^i)), 4}/15

//// Colour
// Cosine palette from Inigo Quilez: a single value in becomes a cycling colour out. a is the level
// the colours swing about, b how far they swing, c how many cycles the incoming 0 to 1 covers and d
// the phase; they are colours rather than numbers, so each channel gets its own cosine, and it is
// the phase spread between them that makes it a palette rather than a grey ramp. The args are in
// reverse order after in, so the phase is the first positional: cospal{#05a} is the full rainbow.
//   px=fbm2>>cospal
//   px=length>>cospal{#05a}
// Note it wants a single value in: px=cospal bare runs red off x and green off y, ie a plaid.
// The args are colours, so hsv and lab work too: cospal{{h:[]n}} turns the phase through the hues.
set cospal = {in,d:#012,c:1,b:1/2,a:1/2} -> (a+b*cos{6.28318*(c*in+d)})

//// Transforms
// A 2x2 matrix on the xy of the incoming value, leaving z and w alone: the cross channel transform
// that mul{} (a diagonal) cannot do, ie rotate, shear, skew and reflect. Translate and scale are
// already add{} and mul{}.
//   x' = xx*x + xy*y
//   y' = yx*x + yy*y
// It is the identity by default, so each argument is a departure from it: mat2{xy:1/2} is a pure
// shear along x, mat2{xx:0,xy:1,yx:1,yy:0} swaps the axes.
//   px=mat2{xy:1/2}>>sdbox{b:{x:1/2,y:1/4}}>>sdfill
// The channel expressions read id rather than in, because a set{} param is built from the input
// set{} itself sees, which the `in >>` has already made in's output; reading in there would apply
// it a second time. The `in >>` (the same shape as sdflat) is what keeps z and w coming from the
// point rather than from whatever the chain happens to be carrying, which is what makes the
// function work when it is called on a point directly instead of being piped one.
set mat2 = {in:id, xx:1, xy:0, yx:0, yy:1} ->
  in >> set{x: id.x*xx + id.y*xy, y: id.x*yx + id.y*yy}

// Rotate xy about the origin, in turns rather than radians: rot2{1/4} is a right angle and
// rot2{[0:1]l8} spins once every 8 beats. The sense matches the rotate standard visual param, ie
// the picture turns anticlockwise; what is being rotated is the coordinate going in, so the matrix
// is the inverse of the picture's own rotation. The coordinates are isotropic (the frame is wider
// than it is tall, but in the same units both ways), so this is a true rotation with no aspect
// correction to do.
//   px=rot2{[0:1]l8}>>tex{webcam{}}
set rot2 = {in:id, a:0} ->
  mat2{in, cos{6.28318*a}, sin{6.28318*a}, -sin{6.28318*a}, cos{6.28318*a}}

//// Patterns
// The pattern generation from the kal visual (shader/kaleidoscope.frag, itself from
// https://www.shadertoy.com/view/Xd2Bzw), converted into DSL: the plane is folded into the unit
// square, turned a little, and folded again, n times over, with the glow either side of the y
// axis accumulated at every level. The per level tint the original mixes in is left out, so this
// gives back a single value in all four channels and colours like any other field.
// The sum runs well past 1 over much of the frame at the default glow, which is what the original
// does too (its palette clamps it); thin the filaments with a smaller glow, or scale it down.
//   px=kal{glow:1/3}
//   px=kal{glow:1/2}/2>>pal{#012,#28a,#fff}
//   px=kal{n:6}/3>>cospal{#05a}

// The turn: a 2x2 whose entries are cosines of one angle at three phases, the leading diagonal
// sharing one. They are passed on to a helper rather than written out because there is nowhere in
// an expression to put a local, which is also why the shared angle k is an argument of kalturn.
// The original builds the matrix with GLSL's mat2(vec4), which is column major, so its second
// component is the top right entry (xy) and its third the bottom left (yx), not the other way up.
set kalturn2 = {q, ca, cb, cc} -> mat2{q, ca, cb, cc, ca}
set kalturn = {q, k, shape} -> kalturn2{q, cos{k+0.78}, cos{k+5.46}, cos{k+0.78*(3+shape)}}

// One level: mirror tile the plane into the unit square with a triangle wave, then turn it. The
// angle winds up as i*i, so each level turns faster than the last, which is what stops the levels
// from staying locked together.
set kalstep = {p, i, t, shape} -> kalturn{abs{2*fract{p-1/2}-1}, t/100*i*i, shape}

// The glow at one level: a filament along y=0 falling off exponentially either side, so what
// accumulates over the levels is a web of them. glow widens and brightens it. The original's 0.4
// overall gain is folded in here, since scaling every term scales the sum.
set kalline = {p, glow} -> exp{-abs{p.y}*5/(2/5+3/5*glow)}*2/5

// n levels, with a line taken at each. The loop carries the folded point and the fold sums the
// lines, which is the one thing the carried value cannot do for itself. sgn{i} drops the seed
// term: the fold seeds itself from the value as it arrives, before any step, where the original
// takes its first line after the first fold. The coordinate is handed to kalstep explicitly
// rather than piped into it, because >> withholds the chain value from a call whose own args
// already hold a visual node, and the loop index is one.
set kal = {in:id, t:time/2, shape:0, glow:1, n:8} ->
  in/4 >> loop{{i} -> kalstep{id, i+1/2, t, shape}, n, map:{v,i} -> sgn{i}*kalline{v, glow}}
