// Smooth noise, 2d/3d transforms, kaleidoscope patterns and a VHS effect for visualsynth px chains.
//
// Value noise interpolates hashed lattice corner values; perlin (gradient) noise interpolates
// hashed corner gradients, so it is less blocky and signed.
//
// All take the incoming px value as their first argument, so they pipe:
//   v1 visualsynth, px=noise2{scale:16}
//   v1 visualsynth, px=fbm2>>tex1d{{x}->{labh:x}}
//   v1 visualsynth, px=noise2>>cospal{#05a}
//   v1 visualsynth, px=fbm2t>>cospal{#036}

//// Shared machinery
// Channels the noise is not over are forced flat so the lattice hashes the same along them. w is
// always forced to zero: pxhash hashes all four components and the incoming w is 1.
set noiseflat1 = {in, scale} -> in*scale >> set{y:0, z:0, w:0}
set noiseflat2 = {in, scale} -> in*scale >> set{z:0, w:0}
set noiseflat3 = {in, scale} -> in*scale >> set{w:0}

// Bilinear value noise over lattice cell i, f the faded fraction. Offsets carry w:0 because an
// absent alpha reads as 1.
set noiseface = {i, f, seed} -> mix{
  mix{ pxhash{i, seed}.x,               pxhash{i+{x:1,w:0}, seed}.x,     f.x },
  mix{ pxhash{i+{y:1,w:0}, seed}.x,     pxhash{i+{x:1,y:1,w:0}, seed}.x, f.x },
  f.y
}

// One corner's gradient contribution. Unused dimensions are flat, so this serves 1d/2d/3d.
set perlingrad = {i, d, o, seed} -> dot{ pxhash{i+o, seed}*2-1, d-o }

set perlinface = {i, d, f, seed} -> mix{
  mix{ perlingrad{i, d, {w:0}, seed},       perlingrad{i, d, {x:1,w:0}, seed},     f.x },
  mix{ perlingrad{i, d, {y:1,w:0}, seed},   perlingrad{i, d, {x:1,y:1,w:0}, seed}, f.x },
  f.y
}

//// Value noise, 0 to 1
// scale is the lattice cells per unit. noise3 takes its third dimension from the incoming z; drive
// it from a timevar for noise that evolves rather than scrolls, eg px=noise3{id>>set{z:[]l8}}
set noise1lerp = {i, f, seed} -> mix{ pxhash{i, seed}.x, pxhash{i+{x:1,w:0}, seed}.x, f.x }
set noise1at = {p, seed} -> noise1lerp{floor{p}, smoothstep{fract{p}}, seed}
set noise1 = {in:id, scale:4, seed:0} -> noise1at{noiseflat1{in, scale}, seed}

set noise2at = {p, seed} -> noiseface{floor{p}, smoothstep{fract{p}}, seed}
set noise2 = {in:id, scale:4, seed:0} -> noise2at{noiseflat2{in, scale}, seed}

// A value noise face as a pxfn{}, so it is one function in the shader however many times it is
// used (twice per 3d noise, once per octave). One body serves both z faces because an integer step
// in z leaves fract{} unchanged. Callers take the node as an argument and apply it at each point.
set noisefacefn = {seed} -> pxfn{{p} -> noiseface{floor{p}, smoothstep{fract{p}}, seed}}
set noise3lerp = {p, f, nf} -> mix{ p>>nf, p+{z:1,w:0}>>nf, f.z }
set noise3at = {p, seed} -> noise3lerp{p, smoothstep{fract{p}}, noisefacefn{seed}}
set noise3 = {in:id, scale:4, seed:0} -> noise3at{noiseflat3{in, scale}, seed}

//// Perlin (gradient) noise
// The s versions are signed, roughly -1 to 1, for displacing coordinates. The plain ones are
// shifted and clamped into 0 to 1.
set perlin1d = {i, d, seed} -> mix{ perlingrad{i, d, {w:0}, seed}, perlingrad{i, d, {x:1,w:0}, seed}, smoothstep{d}.x }
set perlin1at = {p, seed} -> perlin1d{floor{p}, fract{p}, seed}
set perlin1s = {in:id, scale:4, seed:0} -> perlin1at{noiseflat1{in, scale}, seed}
set perlin1 = {in:id, scale:4, seed:0} -> clamp{ perlin1s{in, scale, seed}*3/4 + 1/2 }

set perlin2d = {i, d, seed} -> perlinface{i, d, smoothstep{d}, seed}
set perlin2at = {p, seed} -> perlin2d{floor{p}, fract{p}, seed}
set perlin2s = {in:id, scale:4, seed:0} -> perlin2at{noiseflat2{in, scale}, seed}
set perlin2 = {in:id, scale:4, seed:0} -> clamp{ perlin2s{in, scale, seed}*3/4 + 1/2 }

set perlin3lerp = {i, d, f, seed} -> mix{
  perlinface{i, d, f, seed},
  perlinface{i+{z:1,w:0}, d-{z:1,w:0}, f, seed},
  f.z
}
set perlin3d = {i, d, seed} -> perlin3lerp{i, d, smoothstep{d}, seed}
set perlin3at = {p, seed} -> perlin3d{floor{p}, fract{p}, seed}
set perlin3s = {in:id, scale:4, seed:0} -> perlin3at{noiseflat3{in, scale}, seed}
set perlin3 = {in:id, scale:4, seed:0} -> clamp{ perlin3s{in, scale, seed}*3/4 + 1/2 }

//// Octave noise
// Four octaves, each double the frequency and half the amplitude. To change the octave count,
// change the 4 and the divisor (2^octaves-1).
//
// Each octave is offset half a lattice cell (octshift) in scaled lattice space. Without it every
// octave shares lattice planes, and since smoothstep's slope is zero at cell edges, animating z
// makes the whole picture stall once per cell.
set octshift = {i} -> {x:i/2, y:i/2, z:i/2, w:0}

set fbm2h = {in, scale, nf} ->
  parallel{{i} -> ((noiseflat2{in, scale*(2^i)} + octshift{i}) >> nf)*(8/(2^i)), 4}/15
set fbm2 = {in:id, scale:4, seed:0} -> fbm2h{in, scale, noisefacefn{seed}}

set fbm3 = {in:id, scale:4, seed:0} ->
  parallel{{i} -> noise3at{noiseflat3{in, scale*(2^i)} + octshift{i}, seed}*(8/(2^i)), 4}/15

// Turbulence: the octave sum of absolute signed noise; creased and billowy, for smoke and marble.
set turb2h = {in, scale, nf} ->
  parallel{{i} -> abs{((noiseflat2{in, scale*(2^i)} + octshift{i}) >> nf)*2-1}*(8/(2^i)), 4}/15
set turb2 = {in:id, scale:4, seed:0} -> turb2h{in, scale, noisefacefn{seed}}

set turb3 = {in:id, scale:4, seed:0} ->
  parallel{{i} -> abs{noise3at{noiseflat3{in, scale*(2^i)} + octshift{i}, seed}*2-1}*(8/(2^i)), 4}/15

//// Animated over time
// The 3d noises with z driven by t (default time/8: one lattice cell per 8 beats at scale 4).
// t is applied before scaling, so larger scales animate faster.
//   px=fbm2t>>cospal{#036}
//   px=noise2t{scale:16, t:time/32}
set noise2t   = {in:id, scale:4, seed:0, t:time/8} -> noise3{in>>set{z:t}, scale, seed}
set perlin2t  = {in:id, scale:4, seed:0, t:time/8} -> perlin3{in>>set{z:t}, scale, seed}
set perlin2st = {in:id, scale:4, seed:0, t:time/8} -> perlin3s{in>>set{z:t}, scale, seed}
set fbm2t     = {in:id, scale:4, seed:0, t:time/8} -> fbm3{in>>set{z:t}, scale, seed}
set turb2t    = {in:id, scale:4, seed:0, t:time/8} -> turb3{in>>set{z:t}, scale, seed}

//// Colour
// Inigo Quilez's cosine palette: a is the centre level, b the swing, c the cycles over 0 to 1 and
// d the per channel phase. Args are reversed so the phase is the first positional.
//   px=fbm2>>cospal
//   px=length>>cospal{#05a}
// Wants a single value in: bare px=cospal runs red off x and green off y.
set cospal = {in,d:#012,c:1,b:1/2,a:1/2} -> (a+b*cos{6.28318*(c*in+d)})

//// Transforms
// 2x2 matrix on xy, leaving z and w alone; identity by default.
//   x' = xx*x + xy*y
//   y' = yx*x + yy*y
//   px=mat2{xy:1/2}>>sdbox{b:{x:1/2,y:1/4}}>>sdfill
// The set{} channels must read id, not in: set{} params are built from set{}'s own input, which
// is already in, so reading in would apply it twice. The `in >>` keeps z and w from the point
// when called directly rather than piped. The same applies to mat3, topolar and frompolar.
set mat2 = {in:id, xx:1, xy:0, yx:0, yy:1} ->
  in >> set{x: id.x*xx + id.y*xy, y: id.x*yx + id.y*yy}

// Rotate xy, in turns: rot2{1/4} is a right angle. Rotates the coordinate, so the picture turns
// anticlockwise, matching the rotate param.
//   px=rot2{[0:1]l8}>>tex{webcam{}}
set rot2 = {in:id, a:0} ->
  mat2{in, cos{6.28318*a}, sin{6.28318*a}, -sin{6.28318*a}, cos{6.28318*a}}

// 3x3 matrix on xyz, leaving w alone; identity by default. See mat2 for why it reads id.
set mat3 = {in:id, xx:1, xy:0, xz:0, yx:0, yy:1, yz:0, zx:0, zy:0, zz:1} ->
  in >> set{
    x: id.x*xx + id.y*xy + id.z*xz,
    y: id.x*yx + id.y*yy + id.z*yz,
    z: id.x*zx + id.y*zy + id.z*zz
  }

// Rotate about each axis, in turns. These rotate the coordinate, so shapes turn the other way.
//   px=sd3march{scene:pxfn{{q}->sd3box{rot3y{q,[0:1]l8}, b:1/2}}}>>sd3lit
set rot3x = {in:id, a:0} ->
  mat3{in, yy:cos{6.28318*a}, yz:sin{6.28318*a}, zy:-sin{6.28318*a}, zz:cos{6.28318*a}}

set rot3y = {in:id, a:0} ->
  mat3{in, xx:cos{6.28318*a}, xz:-sin{6.28318*a}, zx:sin{6.28318*a}, zz:cos{6.28318*a}}

set rot3z = {in:id, a:0} ->
  mat3{in, xx:cos{6.28318*a}, xy:sin{6.28318*a}, yx:-sin{6.28318*a}, yy:cos{6.28318*a}}

// Polar coordinates: topolar puts radius in x and angle in y (in turns, -1/2 to 1/2, seam along
// -x; use fract{} for 0 to 1). frompolar is the inverse. See mat2 for why they read id.
//   px=topolar>>cospal
//   px=topolar>>add{y:id.x/4}>>frompolar>>sdbox{b:{x:1,y:1/8}}>>sdfill   // twist
//   px=topolar>>set{y:floor{id.y*8}/8}>>frompolar>>tex{webcam{}}          // pie slices
// The radius is 2d, hence not length{}, which is over xyz.
set topolar = {in:id} ->
  in >> set{x: sqrt{id.x*id.x + id.y*id.y}, y: atan{id.y, id.x}/6.28318}

set frompolar = {in:id} ->
  in >> set{x: id.x*cos{6.28318*id.y}, y: id.x*sin{6.28318*id.y}}

//// Patterns
// The kal visual's pattern (shader/kaleidoscope.frag, from https://www.shadertoy.com/view/Xd2Bzw),
// without the per level tint, so it gives a single value. It runs well past 1 at the default glow.
// shape is first, so px=kal{5} works as for the kal visual. Shape near 2 washes to white; use kal2
// to sweep shape.
//   px=kal{glow:1/3}
//   px=kal{glow:1/2}/2>>pal{#012,#28a,#fff}
//   px=kal{n:6}/3>>cospal{#05a}

// The original uses GLSL mat2(vec4), which is column major: its second component is xy, its
// third yx.
set kalturn2 = {q, ca, cb, cc} -> mat2{q, ca, cb, cc, ca}
set kalturn = {q, k, shape} -> kalturn2{q, cos{k+0.78}, cos{k+5.46}, cos{k+0.78*(3+shape)}}

// Mirror tile into the unit square, then turn. The i*i angle stops the levels locking together.
set kalstep = {p, i, t, shape} -> kalturn{abs{2*fract{p-1/2}-1}, t/100*i*i, shape}

// A filament along y=0, falling off exponentially. Includes the original's 0.4 gain.
set kalline = {p, glow} -> exp{-abs{p.y}*5/(2/5+3/5*glow)}*2/5

// sgn{i} drops the fold's seed term, since the original takes its first line after the first fold.
// The point is passed to kalstep rather than piped because >> does not pipe into a call whose args
// already hold a node (the loop index). kalline is a pxfn{} because loop{} emits its map twice.
set kallinefn = {glow} -> pxfn{{p} -> kalline{p, glow}}
set kalh = {in, t, shape, n, kl} ->
  in/4 >> loop{{i} -> kalstep{id, i+1/2, t, shape}, n, map:{v,i} -> sgn{i}*(v>>kl)}
set kal = {shape:0, in:id, t:time/2, glow:1, n:8} -> kalh{in, t, shape, n, kallinefn{glow}}

//// kal2: kal with a shape that is safe to sweep
// kal's shape changes one matrix entry, which degenerates somewhere: near 2 the frame washes white,
// and making the matrix non-rotational instead lets it go singular, collapsing the frame to white
// at some (large) times. kal2 keeps the matrix at kal's shape 0 (close to a rotation) and gives
// shape two knobs that cannot degenerate. kal2 at shape 0 is exactly kal at shape 0.
//   px=kal2{2, glow:1/3}
//   px=kal2{[0:8]l32, glow:1/2}/2>>pal{#012,#28a,#fff}
set kal2turn = {q, k} -> mat2{q, cos{k+0.78}, cos{k+5.46}, cos{k+2.34}, cos{k+0.78}}

// Knob one: shape adds 0.78*shape*i to each level's turn.
// Do not offset inside the fract: the fold's evenness is what gives the mirror symmetry, and an
// offset moves each level's centre off the origin.
set kal2step = {p, i, t, shape} -> kal2turn{abs{2*fract{p-1/2}-1}, t/100*i*i + 0.78*shape*i}

// Knob two: per level weighting, so shapes differ in density. The phase must be i*i not i: linear,
// shape near 8.06 puts every weight at cos = -1 together and the frame goes black.
set kal2weight = {shape, i} -> 1/2 + cos{0.78*shape*i*i}/2
set kal2h = {in, t, shape, n, kl} ->
  in/4 >> loop{{i} -> kal2step{id, i+1/2, t, shape}, n,
    map:{v,i} -> sgn{i}*(v>>kl)*kal2weight{shape, i-1/2}}
set kal2 = {shape:0, in:id, t:time/2, glow:1, n:8} -> kal2h{in, t, shape, n, kallinefn{glow}}

//// VHS
// The vhs standard visual param (draw/shadercommon.js) for px chains. vhsuv warps the coordinate
// going in, vhsrgb colours what comes out, and vhs{src} wraps a source with both. amt mixes the
// effect in, t is the time it animates by.
//   px=vhs{tex{webcam{}}}
//   px=vhs{tex{webcam{}}, 1/2, t:time*2}
//   px=vhsuv>>tex{webcam{}}>>vhsrgb
// vhsrgb alone re-derives the warp from uv; vhs{} computes it once for both stages.
//
// t is passed as set{t} so its maths runs in the shader rather than making each t expression a
// separate param. The warp is called wp, not w, since its w channel holds the crease phase.
// vhs{} passes id to vhsuvh rather than piping, since a call with a node arg is not piped.
// As in the original, the switching noise does not reach the colour stage.
set vhsrand = {a, b} -> fract{sin{a*12.9898 + b*78.233}*43758.5453}
set vhsrow = {c} -> c.y/2 + 1/2
set vhscrease = {row, t} -> clamp{(sin{row*8 - t*3.14*0.6} - 0.92)*vhsrand{t/2, t/2}, 0, 0.01}*10
// The warp in 0 to 1 coordinates: x and y, then the crease offset in z and crease phase in w
set vhswarpi = {c, row, t, tcn, tc, r, sn} -> set{
  x: c.x/2 + 1/2 - tcn + (vhsrand{row, t} - 1/2)*0.005 + (r - 1/2)*0.01
    + sn*(vhsrand{(row + sn*0.3)*100, t*10} - 1/2)*0.2,
  y: row + sn*0.3, z: tcn, w: tc}
set vhswarph = {c, row, t, tc, r, sn} -> vhswarpi{c, row, t, max{r - 1/2, 0}*1.5*tc, tc, r, sn}
set vhswarpr = {c, row, t} ->
  vhswarph{c, row, t, vhscrease{row, t}, vhsrand{row*100, t*10}, 1 - smoothstep{row, 0, 0.04}}
set vhswarp = {c, t} -> vhswarpr{c, vhsrow{c}, t}

set vhsuvh = {in, wp, amt} -> in >> set{x: mix{id.x, wp.x*2 - 1, amt}, y: mix{id.y, wp.y*2 - 1, amt}}
set vhsuv = {in:id, amt:1, t:time} -> vhsuvh{in, vhswarp{in, set{t}}, amt}

set vhsinside = {wp} -> (wp.x - wp.z*1.5 >= -0.2)*(wp.x <= 1.2)
set vhsflicker = {row, t} -> 1 + clamp{vhsrand{0, row + t*0.2}*0.6 - 0.25, 0, 0.1}
set vhsgain = {in, k} -> in >> mul{r:k, g:k, b:k}
set vhsyiq = {in} -> in >> set{
  x: id.x*0.299 + id.y*0.587 + id.z*0.114,
  y: id.x*0.596 - id.y*0.274 - id.z*0.322,
  z: id.x*0.211 - id.y*0.523 + id.z*0.312}
// Scanlines on luma, 120 across the height; chroma wobble on i and q
set vhsyiqfx = {in, row, t} -> in >> set{
  x: (id.x*0.9 + 0.1)*sin{row*6.28*120}*sin{row*6.28*120}*1.2,
  y: id.y*1.1 - 0.1 + sin{row*3.21 - t*0.79}*0.03,
  z: id.z*1.5 + sin{row*5.33 + t*0.83}*0.03}
set vhsfromyiq = {in} -> in >> set{
  x: id.x + id.y*0.956 + id.z*0.621,
  y: id.x - id.y*0.272 - id.z*0.647,
  z: id.x - id.y*1.106 + id.z*1.703}
set vhsrgbh = {in, row, wp, amt, t} -> mix{clamp{in},
  in >> mix{id, pxfwidth{id}, {r:0.2, g:0.2, b:0.2, a:0}}
    >> vhsgain{(1 - wp.w)*vhsinside{wp}*vhsflicker{row, t}}
    >> vhsyiq >> vhsyiqfx{row, t} >> vhsfromyiq,
  amt}
set vhsrgb = {in:id, amt:1, t:time} -> vhsrgbh{in, vhsrow{uv}, vhswarp{uv, set{t}}, amt, set{t}}

set vhsh = {src, wp, amt, t} -> vhsuvh{id, wp, amt} >> src >> vhsrgbh{vhsrow{uv}, wp, amt, t}
set vhs = {src, amt:1, t:time} -> vhsh{src, vhswarp{uv, set{t}}, amt, set{t}}
