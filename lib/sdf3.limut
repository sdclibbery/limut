include 'lib/sdf.limut'

// 3d signed distance fields and a raymarcher for visualsynth px chains, from the GLSL at
// https://iquilezles.org/articles/distfunctions/
//
//   v1 visualsynth, px=sd3march>>sd3lit
//   set ring = pxfn{{p}->sd3torus{p}}
//   v1 visualsynth, px=sd3march{ring, yaw:[0:1]l8}>>sd3lit{ring}
//   v1 visualsynth, px=let{'scene', pxfn{sd3torus}}>>sd3march{scene}>>sd3lit{scene}
//
// A scene should be a pxfn{}: the march, the normal, shadows and occlusion each call it many times,
// and without pxfn{} every call is another full copy of the scene in the shader. let{} of a pxfn{}
// binds the function itself, so it works everywhere a `set` name would.
//
// The scene is declared first on every function that takes one, so a bare argument lands there.
// With `in` first, px=sd3march{scene} would put the scene in `in`, since a call whose args already
// hold a visual node is not piped the chain value.
//
// A pxfn{} body sees its argument, uv and animated params, but not an outer let{} or loop index, so
// anything positional has to arrive through the point.
//
// Coordinates: y up, x right, -1..1 vertically, z away from the viewer; the default camera is at
// z=-3 looking at the origin.

//// Machinery

// w must be zero: length, dot and cross work on xyz, the incoming w is 1, and a stray w survives
// translates to reappear in the next length.
set sd3flat = {in} -> in >> set{w:0}

// Build a 3d point out of three splatted values, taking one channel from each.
set sd3vec = {a, b, c} -> {x:1,w:0}*a + {y:1,w:0}*b + {z:1,w:0}*c

// Force a colour opaque, since multiplying by a splatted brightness dims alpha too. This must be a
// set{} rather than colour arithmetic: arithmetic on two constants const folds to a value toVec4
// cannot read, which renders as flat white. For the same reason sd3vec and the masks are only used
// on values that already contain a node.
set sd3opaque = {in:id} -> in >> set{w:1}

set sd3reflect = {i, n} -> i - n*2*dot{i,n}

// 2d distance from the y axis, for solids of revolution. Spelt out because length{} is over xyz.
set sd3radial = {p} -> length{sd3vec{p.x, p.z, 0}}

//// Shapes
// All take the point as their first argument, so they pipe or can be handed a point:
// pxfn{{p} -> sd3sphere{p, r:1/2}}. Name the other arguments when the call is not being piped.

set sd3sphere = {in:id, r:1/2} -> sdval{length{sd3flat{in}} - r}

// b is the half extent (centre to face); a number gives a cube, a vector a cuboid.
set sd3box1 = {q} -> sdval{length{max{q,0}} + min{max{q.x, q.y, q.z}, 0}}
set sd3box = {in:id, b:1/2} -> sd3box1{abs{sd3flat{in}} - b}

// Torus in the xz plane: r is the ring radius to the tube centre, t the tube radius.
set sd3torus1 = {q, t} -> sdval{length{q} - t}
set sd3torus = {in:id, r:1/2, t:1/8} ->
  sd3torus1{sd3vec{sd3radial{in} - r, in.y, 0}, t}

// Line segment a to b with radius r.
set sd3capsule1 = {pa, ba, r} -> sdval{length{pa - ba*clamp{dot{pa,ba}/dot{ba,ba}}} - r}
set sd3capsule = {in:id, ax:0, ay:-1/2, az:0, bx:0, by:1/2, bz:0, r:1/4} ->
  sd3capsule1{sd3flat{in} - {x:ax, y:ay, z:az, w:0}, {x:bx-ax, y:by-ay, z:bz-az, w:0}, r}

// Radius r, half height h, standing on the y axis.
set sd3cyl1 = {d} -> sdval{min{max{d.x, d.y}, 0} + length{max{d, 0}}}
set sd3cylinder = {in:id, r:1/2, h:1/2} ->
  sd3cyl1{abs{sd3vec{sd3radial{in}, in.y, 0}} - {x:r, y:h, w:0}}

// Half space below the plane with unit normal nx,ny,nz, lifted by h. Default: a floor at y = -h.
set sd3plane = {in:id, nx:0, ny:1, nz:0, h:1/2} ->
  sdval{dot{sd3flat{in}, {x:nx, y:ny, z:nz, w:0}} + h}

// Radius r, centre to vertex. A bound, not an exact distance: fine to march, but rounding or
// blending it shows the error. 0.57735027 is 1/sqrt(3).
set sd3octahedron = {in:id, r:1/2} ->
  sdval{(abs{in.x} + abs{in.y} + abs{in.z} - r) * 0.57735027}

//// Shapes from 2d ones
// shape is any lib/sdf.limut field, passed as a bare name (sdstar{r:1/2} works).

// Extrude a 2d shape (taken in xy) along z, half thickness h.
//   px=sd3march{scene:pxfn{{p}->sd3extrude{p, sdstar{r:1/2}, h:1/8}}}>>sd3lit
set sd3extrude1 = {w} -> sdval{min{max{w.x, w.y}, 0} + length{max{w, 0}}}
set sd3extrude = {in:id, shape, h:1/4} ->
  sd3extrude1{sd3vec{sd3vec{in.x, in.y, 0} >> shape, abs{in.z} - h, 0}}

// Revolve a 2d shape about the y axis, its origin placed o out from the axis.
//   px=sd3march{scene:pxfn{{p}->sd3revolve{p, sdheart{r:1/3}, o:1/2}}}>>sd3lit
set sd3revolve = {in:id, shape, o:1/2} ->
  sd3vec{sd3radial{in} - o, in.y, 0} >> shape

//// Fractals
// n is structural (the loop count in the shader): it can be changed but not smoothly animated.
// The distances are estimates, so a march can tunnel through detail, showing as banding or holes:
// use sd3march's step:1/2 with more steps, or raise eps. mandelbulb and mandelbox need this more
// than menger and sierpinski. These are expensive; always wrap them in pxfn{}.

// Menger sponge: a cube minus a lattice of crosses at a third the scale each iteration.
// Works in units of b so the cross arithmetic stays as in the original.
//   px=sd3march{pxfn{{p}->sd3menger{p, n:3}}}>>sd3lit
set sd3menger1 = {r, s} -> sdval{(min{max{r.x, r.y}, max{r.y, r.z}, max{r.z, r.x}} - 1) / s}
set sd3menger = {in:id, n:3, b:1/2, scale:3} ->
  (sd3flat{in}/b) >> let{sd3mp, id}
    >> sd3box{b:1}
    >> loop{
         {i} -> id >> let{sd3ma, (sd3mp*sd3ms) % 2 - 1}
                   >> let{sd3ms, sd3ms*scale}
                   >> max{sd3menger1{abs{1 - 3*abs{sd3ma}}, sd3ms}},
         n,
         carry:{sd3ms:1}
       } * b

// Sierpinski tetrahedron / kaleidoscopic IFS. yaw and pitch (in turns) rotate between the folds
// and the scaling; nonzero gives the IFS shapes, and is the thing most worth animating.
// r is the radius of the final sphere in scaled space (real thickness r/scale^n). It is required:
// without it the estimate never goes negative and the march never registers a hit.
//   px=sd3march{pxfn{{p}->sd3sierpinski{p, n:10}}}>>sd3lit
//   px=sd3march{pxfn{{p}->sd3sierpinski{p, n:10, yaw:[0:1]l16}}, step:1/2}>>sd3lit
set sd3sfold1 = {in:id} -> (in.x + in.y < 0 ?? sd3vec{-in.y, -in.x, in.z} ?: in)
set sd3sfold2 = {in:id} -> (in.x + in.z < 0 ?? sd3vec{-in.z, in.y, -in.x} ?: in)
set sd3sfold3 = {in:id} -> (in.y + in.z < 0 ?? sd3vec{in.x, -in.z, -in.y} ?: in)
set sd3sierpde = {in:id, s, r} -> sdval{length{in} - r} * s
set sd3sierpinski = {in:id, n:8, scale:2, ox:1, oy:1, oz:1, yaw:0, pitch:0, r:2} ->
  sd3flat{in}
    >> loop{
         {i} -> id >> sd3sfold1 >> sd3sfold2 >> sd3sfold3
                   >> rot3y{a:yaw} >> rot3x{a:pitch}
                   >> mul{scale}
                   >> add{x:0-ox*(scale-1), y:0-oy*(scale-1), z:0-oz*(scale-1)},
         n
       }
    >> sd3sierpde{s:1/(scale^n), r:r}

// Mandelbox: box fold, sphere fold, scale. dr is the running derivative.
// scale changes the size as much as the character, so b (overall size) must be matched to it:
// 1/8 for scale:2, about 1/4 for -3/2, about 1/12 for 3. A wrong b gives an empty frame, since the
// camera ends up inside or too close to the shape.
//   px=sd3march{pxfn{{p}->sd3mandelbox{p}}, steps:96}>>sd3lit
//   px=sd3march{pxfn{{p}->sd3mandelbox{p, scale:-3/2, b:1/4}}, steps:96}>>sd3lit
set sd3boxfold = {in:id} -> clamp{in, -1, 1}*2 - in
set sd3spherem = {r2, minr2, fixr2} ->
  (r2 < minr2 ?? fixr2/minr2 ?: (r2 < fixr2 ?? fixr2/r2 ?: 1))
set sd3mbde = {in:id, dr} -> sdval{length{in}} / abs{dr}
set sd3mandelbox = {in:id, n:8, scale:2, minr:1/2, fixr:1, b:1/8} ->
  (sd3flat{in}/b) >> let{sd3xc, id}
    >> loop{
         {i} -> id >> sd3boxfold
                   >> let{sd3xm, sd3spherem{dot{id,id}.x, minr*minr, fixr*fixr}}
                   >> mul{sd3xm}
                   >> let{sd3xdr, sd3xdr*sd3xm.x}
                   >> mul{scale} >> add{sd3xc}
                   >> let{sd3xdr, sd3xdr*abs{scale} + 1},
         n,
         carry:{sd3xdr:1}
       }
    >> sd3mbde{dr:sd3xdr.x} >> mul{b}

// Mandelbulb: z -> z^power + c in spherical coordinates, polar axis y so the bulb stands upright.
// power need not be whole (8 is the classic shape, 2 a blob). bail only needs raising for large power.
//   px=sd3march{pxfn{{p}->sd3mandelbulb{p}}, step:1/2, steps:128}>>sd3lit
//   px=sd3march{pxfn{{p}->sd3mandelbulb{p, power:[2:8]l16}}, step:1/2, steps:128}>>sd3lit
set sd3bulb0 = {zr, st, ct, sp, cp} -> sdval{zr} * sd3vec{st*cp, ct, st*sp}
set sd3bulb1 = {zr, tp, pp} -> sd3bulb0{zr, sin{tp}, cos{tp}, sin{pp}, cos{pp}}
set sd3bulbstep = {in:id, r, power} ->
  sd3bulb1{r^power, atan{sd3radial{in}, in.y}*power, atan{in.z, in.x}*power}
set sd3bulbde1 = {r, dr} -> sdval{r*ln{r}/(dr*2)}
set sd3bulbde = {in:id, dr} -> sd3bulbde1{max{length{in}, 1/1000000}, dr}
set sd3mandelbulb = {in:id, n:8, power:8, bail:2} ->
  sd3flat{in} >> let{sd3bc, id}
    >> loop{
         {i} -> id >> let{sd3br, length{id}}
                   >> let{sd3bdr, power*(sd3br.x^(power-1))*sd3bdr.x + 1}
                   >> sd3bulbstep{r:sd3br.x, power:power}
                   >> add{sd3bc},
         n,
         carry:{sd3bdr:1},
         until: sd3br.x > bail
       }
    >> sd3bulbde{dr:sd3bdr.x}

//// Combining
// min{}/max{} and lib/sdf.limut's sdround, sdannular, sdsub, sdblend all work on 3d distances.
// Mirroring into the positive octant is just abs{} on the point:
//   px=sd3march{pxfn{{p}->sd3sphere{abs{p} - {x:1/2,y:1/2,z:1/2,w:0}, 1/4}}}>>sd3lit

// Repeat space on a lattice of spacing p (number or vector; no zero components).
//   px=sd3march{scene:pxfn{{p}->sd3sphere{sd3rep{p, 3/2}, r:1/2}}, far:32}>>sd3lit
set sd3rep = {in:id, p:1} -> sd3flat{in} - p*round{sd3flat{in}/p}

//// Marching
// Ray through the image plane at z = fov; larger fov is a longer lens.
set sd3dir = {in:id, fov:1} -> normalize{sd3vec{in.x, in.y, fov}}

// Default scene, so px=sd3march>>sd3lit shows something: a sphere on a floor.
set sd3default = pxfn{{p} -> min{sd3sphere{p, 1/2}, sd3plane{p, h:1/2}}}

// March a ray from the camera until it hits the scene. Outputs the hit point, and leaves named
// values for shading: sd3d (last distance, in x), sd3t (distance travelled) and sd3n (normal).
// The normal is computed here once so the shading functions can share it.
// Camera at ox,oy,oz looking along +z, turned by pitch then yaw (in turns). steps is structural.
// eps is the hit threshold, far the give-up distance. step scales each step: below 1 for fields
// that overestimate (fractals, sd3octahedron), with steps raised to match.
// Conditions have no and/or: multiply comparisons for and, add them for or.
set sd3march = {scene:sd3default, in:id, ox:0, oy:0, oz:-3, fov:1, yaw:0, pitch:0,
                steps:64, eps:1/2000, far:16, step:1} ->
  in >> let{sd3rd, rot3y{rot3x{sd3dir{id, fov}, pitch}, yaw}}
     >> set{x:ox, y:oy, z:oz, w:0}
     >> loop{
          {i} -> id >> let{sd3d, scene} >> let{sd3dt, sd3d.x*step}
                    >> let{sd3t, sd3t + sd3dt} >> add{sd3rd*sd3dt},
          steps,
          carry:{sd3d:far, sd3t:0},
          until: (sd3d.x < eps) + (sd3t.x > far)
        }
     >> let{sd3n, sd3nrm{scene, id}}

//// Shading
// Surface normal from four tetrahedral samples of the scene. h is the sample spacing: too small is
// noisy, too large rounds edges. sd3march already leaves this in sd3n.
set sd3tet = {e, p, scene, h} -> e * ((p + e*h) >> scene).x
set sd3nrm = {scene:sd3default, in:id, h:1/2000} -> normalize{
    sd3tet{{x:1,y:-1,z:-1,w:0}, in, scene, h}
  + sd3tet{{x:-1,y:-1,z:1,w:0}, in, scene, h}
  + sd3tet{{x:-1,y:1,z:-1,w:0}, in, scene, h}
  + sd3tet{{x:1,y:1,z:1,w:0}, in, scene, h}
}

set sd3lightdir = {lx, ly, lz} -> normalize{{x:lx, y:ly, z:lz, w:0}}

// Soft shadow, 1 lit to 0 shadowed: march toward the light from just off the surface. Smaller k is
// a softer edge. The result is carried in sd3sr and read back by sd3shadow1.
//   px=sd3march{scene}>>sd3lit{scene, shadow:sd3shadow{scene}}
set sd3shadow1 = {in} -> clamp{sd3sr}
set sd3shadow = {scene:sd3default, in:id, lx:1/2, ly:1, lz:-1/2,
                 k:8, steps:24, mint:1/64, far:8} ->
  (sd3flat{in} + sd3n*mint) >> let{sd3sl, sd3lightdir{lx, ly, lz}}
    >> loop{
         {i} -> id >> let{sd3sd, scene}
                   >> let{sd3sr, min{sd3sr, k*sd3sd.x/sd3st.x}}
                   >> let{sd3st, sd3st + clamp{sd3sd.x, 1/64, 1/4}}
                   >> add{sd3sl*clamp{sd3sd.x, 1/64, 1/4}},
         steps,
         carry:{sd3sd:far, sd3sr:1, sd3st:mint},
         until: (sd3sr.x < 1/1000) + (sd3st.x > far)
       }
    >> sd3shadow1

// Ambient occlusion from samples along the normal. steps:4 gives 5 samples (the fold includes the seed).
//   px=sd3march{scene}>>sd3lit{scene, occ:sd3ao{scene}}
set sd3aostep = {i, in, n, scene, hstep, falloff} ->
  (hstep*(i+1) - ((in + n*hstep*(i+1)) >> scene).x) * (falloff^i)
set sd3ao = {scene:sd3default, in:id, steps:4, hstep:1/32, falloff:0.95, k:3} ->
  clamp{1 - k*loop{map:{v,i} -> sd3aostep{i, sd3flat{in}, sd3n, scene, hstep, falloff}, steps}}

// Shade the result of sd3march: one light plus ambient, bg on a miss, fog toward bg (0 = none).
// shadow and occ are multipliers rather than on/off flags because both sides of a ternary are
// always compiled; pass sd3shadow / sd3ao for the expensive version.
//   px=sd3march{scene}>>sd3lit{scene}
//   px=sd3march{scene}>>sd3lit{scene, shadow:sd3shadow{scene}, occ:sd3ao{scene}}
set sd3lit = {scene:sd3default, in:id, lx:1/2, ly:1, lz:-1/2, col:#fff, bg:#123,
              amb:1/5, shadow:1, occ:1, eps:1/500, fog:0} ->
  ( sd3d.x < eps
    ?? mix{
         col * (amb*occ + shadow*max{dot{sd3n, sd3lightdir{lx, ly, lz}}, 0}),
         bg,
         clamp{sd3t*fog}
       }
    ?: bg
  ) >> set{w:1}
