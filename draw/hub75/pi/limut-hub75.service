# systemd unit for the limut HUB75 display. Installed by install.sh.
[Unit]
Description=limut HUB75 display
After=network.target
Wants=network.target
# The receiving card holds its own configuration in flash (set via LEDVISION, 2026-09-05),
# so there is no boot-time reconfiguration step and no ordering constraint on it.

[Service]
Type=simple
User=pi
# The DRM render node is root:render, and /dev/dri/card0 is root:video. Both groups are needed
# for a headless GL context on the v3d driver.
SupplementaryGroups=video render
EnvironmentFile=/etc/default/limut-hub75
ExecStart=/home/pi/limut-hub75/limut-hub75 $HUB75_ARGS
Restart=always
RestartSec=2
# For the Colorlight output stage, which sends raw layer-2 frames on eth0. Granted through the
# unit rather than setcap on the binary, so a rebuild never silently loses it — and the daemon
# still runs as `pi` rather than root.
# One frame is over 1500 packets in a single sendmmsg; the default queue of 1000 silently drops
# the overflow. '+' runs this as root, which setting a queue length needs.
ExecStartPre=+/usr/sbin/ip link set dev eth0 txqueuelen 8000
# The same sendmmsg charges roughly 0.5-0.7 MB of skb truesize against the socket's send buffer,
# and the default ceiling is about 208 KB -- so it sleeps mid-frame waiting for room. The daemon
# is single threaded, so that sleep is time the WebSocket is not drained, and uniform frames are
# then lost to last-write-wins. The daemon asks for 4 MB; this is what lets it have it, since
# SO_SNDBUFFORCE would need CAP_NET_ADMIN and CAP_NET_RAW is all this unit grants.
ExecStartPre=+/usr/sbin/sysctl -q -w net.core.wmem_max=8388608
# The card latches a frame on its sync packet, so the sync must not overtake that frame's rows.
# With eth0's defaults it did, tearing a third of streamed frames: the row and sync packets have
# different type bytes, so they hashed onto different transmit queues, and fq_codel let the lone
# sync jump ahead of the backlogged rows as a "sparse flow". One queue (every CPU steered to tx-0)
# and a plain FIFO keep the wire order the order they were sent in.
ExecStartPre=+/bin/sh -c 'echo f > /sys/class/net/eth0/queues/tx-0/xps_cpus'
ExecStartPre=+/usr/sbin/tc qdisc replace dev eth0 root pfifo limit 10000
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
# Sustained 60Hz: a scheduling delay shows up as a dropped frame, so ask for a little priority.
Nice=-5

[Install]
WantedBy=multi-user.target
